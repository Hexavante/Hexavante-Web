# Banco de dados
DATABASE_URL="mysql://hexavante:senha@hexavante-mysql:3306/hexavante"

# Sessão (o código lê AUTH_SECRET — src/lib/auth-env.ts)
AUTH_SECRET="troque-por-um-segredo-forte"

# API pública (Fastify)
NEXT_PUBLIC_API_URL="https://api.hexavante.com.br"

# URL do app
NEXT_PUBLIC_APP_URL="https://app.hexavante.com.br"

# URL pública da landing (hexavante.com.br) — src/lib/site-url.ts
# Opcional: sem a env, o código usa https://hexavante.com.br
NEXT_PUBLIC_SITE_URL="https://hexavante.com.br"

# E-mail transacional (código de verificação do painel admin) — Resend
# Crie a chave em https://resend.com/api-keys
RESEND_API_KEY=""
# Remetente (precisa do domínio verificado no Resend)
RESEND_FROM="Hexavante <seguranca@hexavante.com.br>"
